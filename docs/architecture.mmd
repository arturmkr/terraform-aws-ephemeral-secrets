  manager["AWS Secrets Manager"]

  engineer --> bootstrap
  bootstrap --> state
  engineer --> environment
  environment -- "remote state + native .tflock" --> state
  environment --> catalog
  catalog --> composition
  composition --> builders
  builders -- "ephemeral outputs" --> composition
  composition --> writer
  writer --> manager

  classDef storage fill:#e8f1ff,stroke:#3973ac,color:#102a43
